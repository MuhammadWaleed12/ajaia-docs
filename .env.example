# Local SQLite (default). Uses a file at ./data/app.db
DATABASE_URL="file:./data/app.db"
# For hosted deployments, use Turso:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"

# Where uploaded attachment files are stored (local filesystem).
UPLOAD_DIR="./uploads"

# Optional: cookie signing secret (only used to mildly obscure the session).
SESSION_SECRET="change-me-in-production"
